# ==============================================================================
# Znero International — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Core Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
SHUTDOWN_TIMEOUT=15s

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# Database (PostgreSQL 16+)
# Application connects using a dedicated non-superuser role (znero_app).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=znero_dev
DB_USER=znero_app
DB_PASSWORD=your_secure_db_password_here
DB_SSLMODE=disable
DATABASE_URL=postgres://znero_app:your_secure_db_password_here@localhost:5432/znero_dev?sslmode=disable
TEST_DATABASE_URL=postgres://znero_app:your_secure_db_password_here@localhost:5432/znero_test?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s

# Apache Kafka (KRaft mode, no ZooKeeper)
KAFKA_HOME=C:\kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=znero-backend
KAFKA_TEST_TOPIC=znero.dev.test
KAFKA_CONSUMER_GROUP=znero-backend-dev
KAFKA_CONSUMER_ENABLED=true
KAFKA_DIAL_TIMEOUT=5s
KAFKA_REQUEST_TIMEOUT=10s

# HTTP Middleware & Security
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1m
READY_CHECK_TIMEOUT=2s

# Security Secrets (NEVER commit real keys)
# MFA_ENCRYPTION_KEY must be a 64-character hex string (32 bytes for AES-256-GCM)
MFA_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# SECRETS_ENCRYPTION_KEY encrypts upstream provider SMPP/HTTP credentials at rest (AES-256-GCM).
# Generate a fresh 32-byte key in PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
# Non-development environments refuse to start if this is missing or left at the dev sample value.
SECRETS_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
SECRETS_KEY_ID=v1
SECRETS_ENCRYPTION_KEYS_PREVIOUS=
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_here
SESSION_COOKIE_NAME=znero_refresh_token

# Frontend (SvelteKit)
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
